{
  "manifest_version": 3,
  "name": "Story Uploader for Instagram",
  "short_name": "Story Uploader",
  "version": "1.1.0",
  "description": "Upload photos and videos to your Instagram story from the desktop, with a true-to-size preview before you share.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/page.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/styles.js",
        "src/media.js",
        "src/instagram.js",
        "src/ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
